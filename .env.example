# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
BOT_STATUS=Custom status here

# Database
DATABASE_URL=postgresql://user:password@host/database

# Internal API Configuration (Backend ↔ Bot Communication)
# ⚠️ Generate a secure secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=generate_your_secret_here

# HMAC secret shared only with website-backend to sign the `moddy:tasks` stream.
# Same value on both services, 32 characters minimum. Never reuse REDIS_PASSWORD.
# ⚠️ Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TASK_STREAM_SECRET=generate_a_different_secret_here

# Deployment window only: accept unsigned `moddy:tasks` entries until the
# backend starts signing. Turn back to false once it does.
TASK_STREAM_ALLOW_UNSIGNED=false

# Internal API Server Port (private, Railway internal network only)
INTERNAL_PORT=3000

# Backend Internal URL (Railway Private Networking)
BACKEND_INTERNAL_URL=http://website-backend.railway.internal:8080

# Moddy Main Discord Server Configuration
MODDY_GUILD_ID=1394001780148535387
MODDY_PREMIUM_ROLE_ID=1424149819185827954

# Other configuration
DEBUG=False
